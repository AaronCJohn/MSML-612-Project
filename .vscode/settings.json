{
  // Build artifacts into a hidden dir next to the root .tex, but keep the PDF next to the .tex.
  // %DIR% is the directory of the root file (here: submission/final).
  "latex-workshop.latex.outDir": "%DIR%/.latex-out",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.build.forceRecipeUsage": true,
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.view.pdf.viewer": "external",
  "latex-workshop.view.pdf.external.viewer.command": "open",
  "latex-workshop.view.pdf.external.viewer.args": [
    "%PDF%"
  ],
  "latex-workshop.latex.recipe.default": "latexmk (xelatex) -> copy PDF next to tex",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (xelatex) -> copy PDF next to tex",
      "tools": [
        "latexmk-xelatex-hidden-outdir",
        "copy-pdf-next-to-tex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xelatex-hidden-outdir",
      "command": "latexmk",
      "args": [
        "-cd",
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "copy-pdf-next-to-tex",
      "command": "/bin/sh",
      "args": [
        "-c",
        "cp \"%OUTDIR%/%DOCFILE%.pdf\" \"%DIR%/%DOCFILE%.pdf\""
      ]
    }
  ]
}

